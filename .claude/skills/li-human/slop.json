  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.] it'?s\\b",
      "name": "\"It's not just X, it's Y\"",
      "fix": "Say the one thing you actually mean. Delete the setup half."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b",
      "name": "\"Not only X but also Y\"",
      "fix": "Split into two sentences, or drop the weaker half."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\b(?:this|it) is(?:n'?t| not) about [^.!?\\n]{2,60}[.!] it'?s about\\b",
      "name": "\"It isn't about X. It's about Y.\"",
      "fix": "Lead with Y. The reversal is the tell."
    },
    {
      "id": "the-result",
      "regex": "(?i)^\\s*(?:the result|the best part|the kicker|the catch)\\?\\s*$",
      "name": "One-word rhetorical question line",
      "fix": "Answer it inline instead of staging a reveal."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\bhere'?s what (?:i|we) learned\\b",
      "name": "\"Here's what I learned\"",
      "fix": "State the lesson. Skip the announcement."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+, and \\w+\\.",
      "name": "Rule-of-three triad",
      "fix": "Two items or four. Three is the model's default rhythm."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Rocket / fire / bulb / sparkle / dart emoji",
      "fix": "One emoji max, and not one of these five."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Hashtag wall (5+)",
      "fix": "Three hashtags. LinkedIn stopped rewarding the wall."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bas an ai\\b|\\bas a language model\\b",
      "name": "Model self-reference",
      "fix": "Delete the sentence."
    },
    {
      "id": "in-summary",
      "regex": "(?i)^\\s*(?:in summary|to summarize|in conclusion)\\b",
      "name": "Essay-closer opener",
      "fix": "A post does not need a conclusion paragraph."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)\\b(?:agree\\?|thoughts\\?|who else\\b|am i wrong\\?)\\s*$",
      "name": "Reflex engagement bait",
      "fix": "Ask a question only you could ask, about the specific thing above it."
    },
    {
      "id": "ru-not-just",
      "regex": "(?i)\\bэто не (?:просто|только) [^.!?\\n]{2,60}[,.—-]\\s*это\\b",
      "name": "«Это не просто X, это Y»",
      "fix": "Скажи одну мысль прямо, убери подводку."
    },
    {
      "id": "ru-not-only",
      "regex": "(?i)\\bне только\\b[^.!?\\n]{2,80}\\bно и\\b",
      "name": "«Не только X, но и Y»",
      "fix": "Раздели на два предложения или убери слабую половину."
    },
    {
      "id": "ru-isnt-about",
      "regex": "(?i)\\bдело не в [^.!?\\n]{2,60}[,.]\\s*(?:а |дело )в\\b",
      "name": "«Дело не в X, а в Y» (шаблонный разворот)",
      "fix": "Допустим один раз на пост. Если это хук, оставь, но не повторяй."
    },
    {
      "id": "ru-the-result",
      "regex": "(?im)^\\s*(?:результат|итог|итого|вывод|фишка|подвох|секрет)\\?\\s*$",
      "name": "Риторический вопрос из одного слова («Результат?»)",
      "fix": "Просто скажи результат."
    },
    {
      "id": "ru-heres-what",
      "regex": "(?i)\\bвот (?:что|чему) (?:я|мы) (?:понял|поняли|узнал|узнали|научил(?:ся|ись))\\b",
      "name": "«Вот что я понял»",
      "fix": "Начни сразу с вывода."
    },
    {
      "id": "ru-summary",
      "regex": "(?im)^\\s*(?:в заключение|подводя итог|резюмируя|таким образом)\\b",
      "name": "Канцелярское «в заключение / таким образом»",
      "fix": "Убери, последняя мысль и так последняя."
    },
    {
      "id": "ru-engagement-bait",
      "regex": "(?i)(?:что думаете\\?|согласны\\?|а вы как думаете\\?|кто со мной\\?|делитесь в комментариях|пишите в комментариях|ставьте лайк|а у вас как\\?)\\s*$",
      "name": "Дежурная приманка для комментариев («Что думаете?»)",
      "fix": "Задай вопрос, который мог бы задать только этот пост."
    },
    {
      "id": "ru-as-ai",
      "regex": "(?i)\\bкак (?:ии|языковая модель|искусственный интеллект),? я\\b",
      "name": "Самоописание ИИ",
      "fix": "Удали."
    },
    {
      "id": "ru-mirror",
      "regex": "(?i)\\b(\\w+) не в [^.!?\\n]{2,40}\\.\\s*\\1 (?:—\\s*)?в\\b",
      "name": "Зеркальная антитеза «Проблема не в X. Проблема в Y.»",
      "fix": "Скажи одним предложением: «дело тут не в людях, а в том, как всё устроено»."
    },
    {
      "id": "ru-mirror2",
      "regex": "(?im)(?:^|[.!?]\\s+)(\\w+ \\w+) не [^.!?\\n]{2,40}\\.\\s*\\n*\\s*\\1\\b",
      "name": "Повтор начала фразы для эффекта («Медленно работают не люди. Медленно работают стыки.»)",
      "fix": "Убери повтор, скажи мысль один раз и просто."
    },
    {
      "id": "ru-q-answer",
      "regex": "\\?\\s+(?:Значит|Нет|Да|Ответ|Всё просто|Ответ простой)\\b",
      "name": "Риторический вопрос с ответом самому себе («X? Значит…»)",
      "fix": "Сделай одно обычное предложение: «Если X, то…»."
    },
